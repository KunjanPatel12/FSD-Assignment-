# FitPulse Backend Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (Choose Local or MongoDB Atlas Cloud):
# Option A - Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/fitpulse
# Option B - MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fitpulse

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=fitpulse_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
